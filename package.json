{
  "name": "bubble-battle",
  "version": "1.0.0",
  "type": "module",
  "description": "Bubble Battle: Campus Chaos",
  "main": "src/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:test": "vite build --mode test --outDir dist-test",
    "preview": "vite preview",
    "preview:test": "vite preview --outDir dist-test --port 4179 --strictPort",
    "test": "vitest run",
    "test:production": "node scripts/verify-production-build.js",
    "test:browser": "npm run build:test && node scripts/verify-browser.js",
    "test:quiz-browser": "npm run build:test && node scripts/verify-quiz.js",
    "qa:browser": "npm run build:test && node scripts/verify-browser.js && node scripts/verify-quiz.js",
    "qa": "npm run test && npm run build && npm run test:production && npm run qa:browser",
    "screenshots": "npm run build:test && node scripts/capture-screenshots.js"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
